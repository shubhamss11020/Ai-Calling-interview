# ===== Application =====
PROJECT_NAME="TalentVoice AI"
# development | production (production = JSON logs)
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# true = queue screening/evaluation on Celery workers (needs the workers running)
ASYNC_PROCESSING=false

# ===== Neon Postgres (required) =====
# Neon console -> Connect -> pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ===== Upstash Redis (required) =====
# Use the TLS URL (rediss://). Upstash has one database: no /1 or /2 suffix.
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
# Leave the next two empty to reuse REDIS_URL
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ===== LLMs =====
GROQ_API_KEY=
# Also used for embeddings (RAG)
GEMINI_API_KEY=
# Providers retire models: list yours with GET https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.5-flash
RAG_ENABLED=true

# ===== Voice =====
# Live speech-to-text and text-to-speech
DEEPGRAM_API_KEY=
# stream | gather  (gather = Vobiz built-in speech recognition)
VOICE_MODE=stream

# ===== Telephony (Vobiz) =====
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# E.164, e.g. +918012345678
VOBIZ_PHONE_NUMBER=
# Public HTTPS URL of this backend (ngrok or deployed host). run-dev.ps1 sets it automatically.
PUBLIC_BASE_URL=https://your-api.example.com
# Extra hostnames allowed to use the full (unauthenticated) API. Leave empty unless auth is added.
FULL_API_HOSTS=[]

# ===== Optional: LangSmith tracing =====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=talentvoice
